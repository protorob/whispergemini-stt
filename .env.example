# Copy this file to .env and uncomment/edit what you need. For local dev
# (`uvicorn app.main:app`), .env is loaded automatically. For Docker/Coolify,
# set these as real environment variables through that platform instead —
# .env isn't wired into docker-compose.yml (Coolify manages env vars itself).

# --- faster-whisper ---
# Leave these unset to auto-detect based on the machine's hardware (GPU/CPU/
# RAM) — see PLAN.md's decision matrix. Only set to override the detected
# default, e.g. to force a smaller model on a shared/constrained host.
# WHISPER_MODEL=large-v3          # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=cuda             # cpu | cuda
# WHISPER_COMPUTE_TYPE=float16    # e.g. int8, float16, int8_float16

# --- Hugging Face Hub ---
# Anonymous downloads are rate-limited and can fail partway through large
# model files (e.g. large-v3's ~3GB model.bin), leaving an incomplete local
# cache. Set a free HF access token (https://huggingface.co/settings/tokens)
# to get much higher/no rate limits. huggingface_hub reads this env var
# automatically — no other wiring needed.
#
# This same token is also REQUIRED (not just rate-limit relief) to enable
# speaker diarization (see requirements-diarization.txt below): you must
# also accept the license/terms for pyannote/speaker-diarization-3.1 (and
# its dependency pyannote/segmentation-3.0) on huggingface.co while logged
# in as the account this token belongs to, or diarization will fail to
# load the pipeline even with a valid token.
# HF_TOKEN=hf_xxx

# --- Speaker diarization (optional — see requirements-diarization.txt) ---
# No separate env var to enable it: the "Multiple speakers" option in the
# UI is available whenever pyannote.audio is importable AND HF_TOKEN above
# is set (checked once at startup, see GET /api/capabilities). Pulls in
# PyTorch — CPU works, GPU is faster but not required.

# --- Parakeet (optional, GPU-only engine — see requirements-gpu.txt) ---
# PARAKEET_MODEL=nvidia/parakeet-tdt-1.1b
# Comma-separated. Operator-declared, not auto-probed from the model — see
# README's Parakeet design notes for why. Must match what PARAKEET_MODEL
# above actually supports if you change it.
# PARAKEET_LANGUAGES=en

# --- Gemini AI formatting ---
# Only the default model lives here. The Gemini API key itself is NOT an
# env var — it's entered in the browser UI and sent per-request, never
# stored server-side (see README's "API key handling").
# GEMINI_MODEL=gemini-3.5-flash
